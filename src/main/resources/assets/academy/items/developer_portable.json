{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "academy:energy",
          "entries": [
            {
              "threshold": 0.5,
              "model": {
                "type": "minecraft:model",
                "model": "academy:item/developer_portable_half"
              }
            },
            {
              "threshold": 1,
              "model": {
                "type": "minecraft:model",
                "model": "academy:item/developer_portable_full"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "academy:item/developer_portable"
          }
        }
      },
      {
        "when": "thirdperson_lefthand",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "thirdperson_lefthand"
          }
        }
      },
      {
        "when": "thirdperson_righthand",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "thirdperson_righthand"
          }
        }
      },
      {
        "when": "firstperson_lefthand",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "firstperson_lefthand"
          }
        }
      },
      {
        "when": "firstperson_righthand",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "firstperson_righthand"
          }
        }
      },
      {
        "when": "head",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "head"
          }
        }
      },
      {
        "when": "ground",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "ground"
          }
        }
      },
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "fixed"
          }
        }
      },
      {
        "when": "on_shelf",
        "model": {
          "type": "minecraft:special",
          "base": "academy:item/developer_portable_held",
          "model": {
            "type": "academy:held",
            "kind": "developer_portable",
            "context": "on_shelf"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "academy:item/developer_portable_held",
      "model": {
        "type": "academy:held",
        "kind": "developer_portable",
        "context": "none"
      }
    }
  }
}
